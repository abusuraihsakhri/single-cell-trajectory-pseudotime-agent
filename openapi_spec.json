{
  "openapi": "3.1.0",
  "info": {
    "title": "Metric Screening Audit API",
    "description": "Legacy threshold/keyword rule-based metric screening; not diffusion pseudotime or clinical decision support.",
    "version": "2.0.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Status and service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON task and audit counts",
        "responses": {
          "200": {
            "description": "In-memory counts and signature-chain verification"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Apply legacy metric-screening rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-based dossier and associated in-memory audit hash"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve in-memory audit chain when token access is enabled",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Invalid audit log token"
          },
          "404": {
            "description": "Audit log access disabled"
          }
        },
        "description": "Disabled until AUDIT_LOGS_TOKEN is configured; then requires an Authorization: Bearer token."
      }
    }
  }
}
